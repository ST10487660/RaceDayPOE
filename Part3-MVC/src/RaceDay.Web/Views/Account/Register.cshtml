@model RegisterViewModel
@{
    ViewData["Title"] = "Join RaceDay";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card rd-form-card">
            <div class="card-body p-4">
                <h1 class="rd-h1 mb-1">Join RaceDay</h1>
                <p class="rd-muted mb-4">Create your account and choose how you will use RaceDay.</p>
                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" required />
                        <span asp-validation-for="FullName" class="rd-field-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" required />
                        <span asp-validation-for="Email" class="rd-field-error"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required />
                            <span asp-validation-for="Password" class="rd-field-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
                            <span asp-validation-for="ConfirmPassword" class="rd-field-error"></span>
                        </div>
                    </div>
                    <fieldset class="mb-3">
                        <legend class="form-label fs-6">I am joining as</legend>
                        <div class="rd-role-choice">
                            <label class="rd-role-option">
                                <input type="radio" name="Role" value="Participant" checked="@(Model.Role == "Participant")" />
                                <span><strong>Participant</strong><small>Enter events and track my results</small></span>
                            </label>
                            <label class="rd-role-option">
                                <input type="radio" name="Role" value="Organiser" checked="@(Model.Role == "Organiser")" />
                                <span><strong>Organiser</strong><small>Create events and capture results</small></span>
                            </label>
                        </div>
                        <span asp-validation-for="Role" class="rd-field-error"></span>
                    </fieldset>
                    <div class="mb-4" id="inviteBlock" hidden>
                        <label asp-for="InviteCode" class="form-label"></label>
                        <input asp-for="InviteCode" class="form-control" autocomplete="off" />
                        <div class="form-text">Organiser accounts need an invite code from the RaceDay team.</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Create account</button>
                </form>
                <p class="text-center rd-muted mt-4 mb-0">Already have an account? <a asp-action="Login">Log in</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
