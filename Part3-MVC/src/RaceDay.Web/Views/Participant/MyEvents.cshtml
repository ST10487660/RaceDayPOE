@model List<ApiEnrolment>
@{
    ViewData["Title"] = "My Events";
    var today = ViewHelpers.Today;
}
<h1 class="rd-h1">My Events</h1>
<p class="rd-muted mb-4">Every event you have entered, and where your enrolment stands.</p>

@if (Model.Count == 0)
{
    <div class="rd-empty text-center">
        <div class="rd-empty-icon">&#127939;</div>
        <h2 class="rd-h2">You have not entered any events yet</h2>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Find an event</a>
    </div>
}
else
{
    <div class="card"><div class="table-responsive">
    <table class="table rd-table align-middle mb-0">
        <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model.OrderByDescending(x => x.EventDate))
        {
            <tr>
                <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="rd-link">@e.EventName</a></td>
                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                <td>@e.CategoryName</td>
                <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                <td><partial name="_StatusBadge" model="@e.Status" /></td>
                <td class="text-end">
                    @if (e.Status != "Cancelled" && e.EventDate >= today)
                    {
                        <form asp-action="CancelEnrolment" method="post" onsubmit="return confirm('Cancel your enrolment for @e.EventName?');">
                            <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
