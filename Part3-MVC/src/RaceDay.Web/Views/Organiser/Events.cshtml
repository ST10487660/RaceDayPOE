@model List<ApiEvent>
@{
    ViewData["Title"] = "My Events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="rd-h1 mb-0">My Events</h1>
        <p class="rd-muted mb-0">Create, edit and delete the events you organise.</p>
    </div>
    <a class="btn btn-primary" asp-action="CreateEvent">+ New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty text-center">
        <div class="rd-empty-icon">&#128197;</div>
        <h2 class="rd-h2">No events yet</h2>
        <a class="btn btn-primary" asp-action="CreateEvent">Create an event</a>
    </div>
}
else
{
    <div class="card"><div class="table-responsive">
    <table class="table rd-table align-middle mb-0">
        <thead><tr><th>Event</th><th>Type</th><th>Date</th><th>Distance</th><th>Enrolled</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model.OrderByDescending(x => x.EventDate))
        {
            <tr>
                <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="rd-link">@e.EventName</a><br /><span class="rd-muted">@e.Location</span></td>
                <td><span class="rd-type-pill">@e.EventType</span></td>
                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                <td>@e.DistanceKm.ToString("0.##") km</td>
                <td>@e.EnrolledCount / @e.MaxParticipants</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Results" asp-route-id="@e.EventId">Results</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="EditEvent" asp-route-id="@e.EventId">Edit</a>
                    <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline" onsubmit="return confirm('Delete @e.EventName? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
