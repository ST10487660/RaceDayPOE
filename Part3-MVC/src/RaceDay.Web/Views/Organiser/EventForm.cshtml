@model EventFormViewModel
@inject IAssetUrlResolver Assets
@{
    var editing = Model.EventId.HasValue;
    ViewData["Title"] = editing ? "Edit event" : "New event";
    var existingBanner = Assets.Resolve(Model.ExistingBannerUrl);
}
<h1 class="rd-h1 mb-4">@(editing ? "Edit event" : "Create a new event")</h1>

<div class="card rd-form-card"><div class="card-body p-4">
<form method="post" enctype="multipart/form-data" asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="EventName" class="form-label"></label>
            <input asp-for="EventName" class="form-control" required />
            <span asp-validation-for="EventName" class="rd-field-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select" required>
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
            <span asp-validation-for="EventType" class="rd-field-error"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="rd-field-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="EventDate" class="form-label"></label>
            <input asp-for="EventDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
            <span asp-validation-for="EventDate" class="rd-field-error"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" required />
            <span asp-validation-for="Location" class="rd-field-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DistanceKm" class="form-label"></label>
            <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" required />
            <span asp-validation-for="DistanceKm" class="rd-field-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="MaxParticipants" class="form-label"></label>
            <input asp-for="MaxParticipants" type="number" min="1" class="form-control" required />
            <span asp-validation-for="MaxParticipants" class="rd-field-error"></span>
        </div>

        <div class="col-12">
            <label class="form-label">Categories offered at this event</label>
            @if (Model.AvailableCategories.Count == 0)
            {
                <p class="rd-muted mb-0">No categories exist yet. <a asp-action="Categories">Add some first</a>, then come back to attach them.</p>
            }
            else
            {
                <div class="rd-check-grid">
                    @foreach (var c in Model.AvailableCategories)
                    {
                        <label class="rd-check">
                            <input type="checkbox" name="SelectedCategoryIds" value="@c.CategoryId" checked="@Model.SelectedCategoryIds.Contains(c.CategoryId)" />
                            <span>@c.CategoryName</span>
                        </label>
                    }
                </div>
            }
        </div>

        <div class="col-12">
            <label asp-for="Banner" class="form-label"></label>
            @if (existingBanner != null)
            {
                <div class="mb-2"><img src="@existingBanner" alt="Current banner" class="rd-banner-preview" /></div>
            }
            <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
            <div class="form-text">JPEG, PNG or WebP, up to 5 MB. @(editing ? "Choose a file only if you want to replace the current banner." : "Shown on the event page.")</div>
            <span asp-validation-for="Banner" class="rd-field-error"></span>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
    </div>
</form>
</div></div>
