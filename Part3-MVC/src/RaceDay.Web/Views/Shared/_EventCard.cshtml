@model ApiEvent
@inject IAssetUrlResolver Assets
@{
    var banner = Assets.Resolve(Model.BannerImageUrl);
    var spotsLeft = Math.Max(0, Model.MaxParticipants - Model.EnrolledCount);
}
<div class="card rd-event-card h-100">
    @if (banner != null)
    {
        <img src="@banner" class="rd-event-banner" alt="Banner for @Model.EventName" />
    }
    else
    {
        <div class="rd-event-banner rd-banner-placeholder type-@Model.EventType.ToLowerInvariant()">
            <span>@ViewHelpers.TypeIcon(Model.EventType)</span>
        </div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="rd-type-pill">@Model.EventType</span>
            <span class="rd-date">@Model.EventDate.ToString("dd MMM yyyy")</span>
        </div>
        <h3 class="rd-card-title">@Model.EventName</h3>
        <p class="rd-muted mb-1">@Model.Location</p>
        <p class="rd-muted mb-3">@Model.DistanceKm.ToString("0.##") km &middot; @spotsLeft spots left</p>
        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event</a>
    </div>
</div>
