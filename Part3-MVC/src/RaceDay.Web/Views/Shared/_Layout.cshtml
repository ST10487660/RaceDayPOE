@inject ICurrentUser CurrentUser
@inject IAssetUrlResolver Assets
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var roleClass = CurrentUser.IsOrganiser ? "role-organiser" : CurrentUser.IsParticipant ? "role-participant" : "role-guest";
    string Active(string c, string a = "") => controller == c && (a == "" || action == a) ? "active" : "";
    var avatar = Assets.Resolve(CurrentUser.ProfilePictureUrl);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@roleClass">
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="@(CurrentUser.IsOrganiser ? "Organiser" : "Home")" asp-action="@(CurrentUser.IsOrganiser ? "Dashboard" : "Index")">
                RACE<span>DAY</span>
                @if (CurrentUser.IsOrganiser)
                {
                    <small class="rd-console-tag">Organiser console</small>
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (CurrentUser.IsOrganiser)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Events")" asp-controller="Organiser" asp-action="Events">My Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Categories")" asp-controller="Organiser" asp-action="Categories">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Public site</a></li>
                    }
                    else if (CurrentUser.IsParticipant)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Events</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (CurrentUser.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2 @Active("Profile")" asp-controller="Profile" asp-action="Index">
                                @if (avatar != null)
                                {
                                    <img src="@avatar" alt="" class="rd-avatar rd-avatar-sm" />
                                }
                                else
                                {
                                    <span class="rd-avatar rd-avatar-sm rd-avatar-initials">@ViewHelpers.Initials(CurrentUser.FullName)</span>
                                }
                                <span>@CurrentUser.FullName</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light ms-lg-2">Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Account", "Login")" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-sm btn-primary ms-lg-2" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span class="rd-brand-sm">RACE<span>DAY</span></span>
            <span>Run. Walk. Cycle. Race day starts here.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
